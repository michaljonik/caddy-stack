{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Warsaw",
  "labels": ["dependencies"],
  "semanticCommits": "disabled",
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "schedule": ["* 0-6 * * 1"],
  "vulnerabilityAlerts": { "minimumReleaseAge": null, "schedule": [] },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Plugins built in by xcaddy, and transitive modules forced with --replace",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "--with (?<depName>[^@\\s]+)@(?<currentValue>v[0-9][^\\s\\\\]*)",
        "--replace (?<depName>[^=\\s]+)=[^@\\s]+@(?<currentValue>v[0-9][^\\s\\\\]*)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Plugin table in the README, kept in step with the Dockerfile",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["\\| \\[(?<depName>[^\\]]+)\\]\\(https://github\\.com/[^)]+\\) \\| (?<currentValue>v[0-9][^\\s|]*) \\|"],
      "depNameTemplate": "github.com/{{{depName}}}",
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "description": "Both FROM lines (builder and runtime) move together",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["caddy"],
      "groupName": "caddy"
    },
    {
      "description": "GitHub Actions: once a month, one pull request",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "schedule": ["* 0-6 1-7 * 1"]
    }
  ]
}
